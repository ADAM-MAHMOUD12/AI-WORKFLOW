{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": "vercel edition/app",
      "framework": "vite"
    },
    "backend": {
      "root": "vercel edition/app/backend",
      "framework": "fastapi",
      "entrypoint": "main:app",
      "installCommand": "pip install -r requirements-vercel.txt",
      "bindings": [
        {
          "type": "service",
          "service": "engine-three",
          "format": "url",
          "env": "AEDIFEX_URL"
        }
      ]
    },
    "engine-three": {
      "root": "vercel edition/app/vendor/aedifex",
      "runtime": "container",
      "entrypoint": "Dockerfile"
    }
  },
  "rewrites": [
    { "source": "/icons/(.*)", "destination": { "service": "engine-three", "path": "/icons/$1" } },
    { "source": "/audios/(.*)", "destination": { "service": "engine-three", "path": "/audios/$1" } },
    { "source": "/items/(.*)", "destination": { "service": "engine-three", "path": "/items/$1" } },
    { "source": "/material/(.*)", "destination": { "service": "engine-three", "path": "/material/$1" } },
    { "source": "/hdri/(.*)", "destination": { "service": "engine-three", "path": "/hdri/$1" } },
    { "source": "/demos/(.*)", "destination": { "service": "engine-three", "path": "/demos/$1" } },
    { "source": "/fonts/(.*)", "destination": { "service": "engine-three", "path": "/fonts/$1" } },
    { "source": "/logo-200.png", "destination": { "service": "engine-three", "path": "/logo-200.png" } },
    { "source": "/engine/3d/api/(.*)", "destination": { "service": "backend", "path": "/api/$1" } },
    {
      "source": "/engine/3d",
      "destination": { "service": "engine-three" }
    },
    {
      "source": "/engine/3d/(.*)",
      "destination": { "service": "engine-three" }
    },
    {
      "source": "/api/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "app" }
    }
  ]
}