{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": "vercel edition/app",
      "framework": "vite"
    },
    "backend": {
      "root": "vercel edition/app/backend",
      "framework": "fastapi",
      "entrypoint": "main:app",
      "installCommand": "pip install -r requirements-vercel.txt",
      "bindings": [
        {
          "type": "service",
          "service": "engine-three",
          "format": "url",
          "env": "AEDIFEX_URL"
        }
      ]
    },
    "engine-three": {
      "root": "vercel edition/app/vendor/aedifex",
      "runtime": "docker",
      "dockerfile": "Dockerfile"
    }
  },
  "rewrites": [
    {
      "source": "/engine/3d",
      "destination": { "service": "engine-three" }
    },
    {
      "source": "/engine/3d/(.*)",
      "destination": { "service": "engine-three" }
    },
    {
      "source": "/api/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "app" }
    }
  ]
}