{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": "app",
      "framework": "vite"
    },
    "backend": {
      "root": "app/backend",
      "framework": "fastapi",
      "entrypoint": "main:app",
      "installCommand": "pip install -r requirements-vercel.txt"
    },
    "engine3d": {
      "root": "app/vendor/aedifex",
      "framework": "nextjs",
      "buildCommand": "npx --yes bun@1.4.4 install --frozen-lockfile && npx --yes bun@1.4.4 run turbo run build --filter=./apps/editor... --concurrency=1"
    }
  },
  "rewrites": [
    {
      "source": "/engine/3d",
      "destination": {
        "service": "engine3d"
      }
    },
    {
      "source": "/engine/3d/(.*)",
      "destination": {
        "service": "engine3d"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
