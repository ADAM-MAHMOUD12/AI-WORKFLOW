{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": "app",
      "framework": "vite"
    },
    "backend": {
      "root": "app/backend",
      "framework": "fastapi",
      "entrypoint": "main:app",
      "installCommand": "pip install -r requirements-vercel.txt"
    },
    "engine2d": {
      "root": "app/vendor/opencalque",
      "framework": "vite",
      "buildCommand": "corepack enable && pnpm install --frozen-lockfile && pnpm build:web",
      "outputDirectory": "apps/web/dist"
    },
    "engine3d": {
      "root": "app/vendor/aedifex",
      "framework": "nextjs",
      "buildCommand": "bun install --frozen-lockfile && bun run turbo run build --filter=./apps/editor... --concurrency=1"
    }
  },
  "rewrites": [
    {
      "source": "/engine/2d/(.*)",
      "destination": {
        "service": "engine2d"
      }
    },
    {
      "source": "/engine/3d/(.*)",
      "destination": {
        "service": "engine3d"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
