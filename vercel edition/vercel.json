{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": "app",
      "framework": "vite"
    },
    "backend": {
      "root": "app/backend",
      "framework": "fastapi",
      "entrypoint": "main:app",
      "installCommand": "pip install -r requirements-vercel.txt",
      "bindings": [
        {
          "type": "service",
          "service": "engine3d",
          "format": "url",
          "env": "AEDIFEX_URL"
        }
      ]
    },
    "engine3d": {
      "root": "app/vendor/aedifex/apps/editor",
      "framework": "nextjs",
      "installCommand": "npx --yes bun@1.4.4 install --frozen-lockfile",
      "buildCommand": "npx --yes bun@1.4.4 run build",
      "outputDirectory": ".next"
    }
  },
  "rewrites": [
    {
      "source": "/engine/3d",
      "destination": {
        "service": "engine3d"
      }
    },
    {
      "source": "/engine/3d/(.*)",
      "destination": {
        "service": "engine3d"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
