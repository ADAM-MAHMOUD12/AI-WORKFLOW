{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": "app",
      "framework": "vite"
    },
    "backend": {
      "root": "app/backend",
      "framework": "fastapi",
      "entrypoint": "main:app",
      "installCommand": "pip install -r requirements-vercel.txt",
      "bindings": [
        {
          "type": "service",
          "service": "engine-three",
          "format": "url",
          "env": "AEDIFEX_URL"
        }
      ]
    },
    "engine-three": {
      "root": "app/vendor/aedifex",
      "runtime": "container",
      "entrypoint": "Dockerfile"
    }
  },
  "rewrites": [
    { "source": "/icons/(.*)", "destination": { "service": "engine-three", "path": "/engine/3d/icons/$1" } },
    { "source": "/audios/(.*)", "destination": { "service": "engine-three", "path": "/engine/3d/audios/$1" } },
    { "source": "/items/(.*)", "destination": { "service": "engine-three", "path": "/engine/3d/items/$1" } },
    { "source": "/material/(.*)", "destination": { "service": "engine-three", "path": "/engine/3d/material/$1" } },
    { "source": "/hdri/(.*)", "destination": { "service": "engine-three", "path": "/engine/3d/hdri/$1" } },
    { "source": "/demos/(.*)", "destination": { "service": "engine-three", "path": "/engine/3d/demos/$1" } },
    { "source": "/fonts/(.*)", "destination": { "service": "engine-three", "path": "/engine/3d/fonts/$1" } },
    { "source": "/logo-200.png", "destination": { "service": "engine-three", "path": "/engine/3d/logo-200.png" } },
    { "source": "/engine/3d/api/scenes", "destination": { "service": "backend", "path": "/api/scenes" } },
    { "source": "/engine/3d/api/scenes/(.*)", "destination": { "service": "backend", "path": "/api/scenes/$1" } },
    {
      "source": "/engine/3d",
      "destination": {
        "service": "engine-three"
      }
    },
    {
      "source": "/engine/3d/(.*)",
      "destination": {
        "service": "engine-three"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
