# Local development defaults
TASKFLOW_ENV=development
TASKFLOW_HOST=127.0.0.1
TASKFLOW_PORT=8000
TASKFLOW_DATABASE=./data/taskflow.db
# Optional: set this to a PostgreSQL URL (local, Neon, or hosted). When set, PostgreSQL is used.
TASKFLOW_DATABASE_URL=

# Generate a key with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TASKFLOW_ENCRYPTION_KEY=PASTE_GENERATED_FERNET_KEY_HERE

# Optional: use Tavily as the preferred web-search provider. Bing RSS is used otherwise.
TASKFLOW_TAVILY_API_KEY=

# Comma-separated frontend origins
TASKFLOW_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Leave empty for local-only development.
# Do NOT expose this starter backend publicly without real user authentication.
TASKFLOW_API_TOKEN=
